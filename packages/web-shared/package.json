{
  "name": "@scoutui/web-shared",
  "version": "0.1.0",
  "description": "Storage and read models behind the Scout dashboard.",
  "homepage": "https://scoutui.dev",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome lint src tests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@scoutui/scan-format": "0.1.0",
    "drizzle-orm": "0.45.2",
    "liqe": "^3.8.5",
    "pg": "8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
