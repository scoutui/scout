{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/@scoutui/cli/schema/config.schema.json",
  "title": "Scout config",
  "type": "object",
  "additionalProperties": false,
  "required": ["include"],
  "properties": {
    "$schema": { "type": "string" },
    "repoId": { "type": "string", "minLength": 1 },
    "host": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "include": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "exclude": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "gitignore": { "type": "boolean" },
    "tsconfigPath": { "type": "string", "minLength": 1 },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "install": {
      "type": "string",
      "minLength": 1,
      "description": "The command scout backfill runs at each commit to install dependencies, from the repository root. Leave it out and backfill works it out from the lockfile."
    }
  }
}
