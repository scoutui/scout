{
  "name": "@scoutui/cli",
  "version": "0.1.0",
  "description": "Scan React and Vue repos for design-system component usage, and upload the results to a Scout dashboard.",
  "homepage": "https://scoutui.dev",
  "keywords": [
    "design-system",
    "component-usage",
    "component-analytics",
    "react",
    "vue",
    "custom-elements",
    "web-components",
    "cli"
  ],
  "license": "MIT",
  "bugs": "https://github.com/scoutui/scout/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scoutui/scout.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "scout": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema",
    "examples",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./schema/config.schema.json": "./schema/config.schema.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome lint src tests scripts",
    "clean": "rm -rf dist .turbo",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "corepack": "0.36.0",
    "oxc-parser": "0.130.0"
  },
  "devDependencies": {
    "@babel/parser": "7.29.3",
    "@babel/types": "7.29.0",
    "@clack/prompts": "^1.5.1",
    "@oxc-project/types": "0.130.0",
    "@scoutui/parser-react": "0.1.0",
    "@scoutui/parser-vue": "0.1.0",
    "@scoutui/reference-graph": "0.1.0",
    "@scoutui/scan-format": "0.1.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.12.2",
    "@types/picomatch": "4.0.3",
    "@vue/compiler-sfc": "3.5.33",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "globby": "16.2.0",
    "js-yaml": "5.4.1",
    "jsonc-parser": "^3.3.1",
    "oxc-walker": "1.0.0",
    "picomatch": "4.0.4",
    "typescript": "5.9.3",
    "ulid": "3.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
