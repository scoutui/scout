{
  "name": "@scoutui/parser-angular",
  "version": "0.1.0",
  "description": "Finds the components used in Angular templates for the Scout CLI.",
  "homepage": "https://scoutui.dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome lint src tests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@scoutui/reference-graph": "0.1.0"
  },
  "devDependencies": {
    "@angular/compiler-19": "npm:@angular/compiler@19.2.25",
    "@angular/compiler-20": "npm:@angular/compiler@20.3.34",
    "@angular/compiler-21": "npm:@angular/compiler@21.2.25",
    "@angular/compiler-22": "npm:@angular/compiler@22.2.4",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  }
}
