{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "strict": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@ds": ["../node_modules/@example/react-ds/src/index.js"],
      "dsx": ["../node_modules/@example/react-ds/src/index.js"],
      "@ds/ui": ["../node_modules/@example/react-ds/src/index.js"],
      "@shared": ["../shared/Button.js"]
    }
  },
  "include": ["src/**/*"]
}
