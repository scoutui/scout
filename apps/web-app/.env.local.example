DATABASE_URL=postgres://scout:scout@localhost:5432/scout
# Optional IdP group gate at browser sign-in. When set (e.g. scout-users),
# the IdP userinfo response must confirm this group to sign in. If the group
# cannot be checked, sign-in is denied until the user retries. Unset = no group
# gate. Existing CLI sessions are not rechecked against IdP groups.
SCOUTUI_REQUIRED_GROUP=

# Admins: people named here are Admins. Set at least one, unless you use the
# dev sign-in below, which picks a role at sign-in.
# SCOUTUI_ADMINS: comma-separated emails; each counts only when the sign-in
# provider marks it verified.
# SCOUTUI_ADMIN_GROUP: a group in your sign-in provider; its members are Admins.
SCOUTUI_ADMINS=
SCOUTUI_ADMIN_GROUP=

# OIDC sign-in. Point at any OIDC-compliant IdP (Authentik, Okta, Google,
# Keycloak, etc.); the web app discovers endpoints from the issuer's
# /.well-known/openid-configuration. All three values are required together.
# In local dev with DEV_AUTH_PASSWORD set (see below), leave all three unset to
# use the dev sign-in form alone.
# OIDC_ISSUER_URL=https://auth.example.com/application/o/scout/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# Comma-separated allow-list of email domains, for IdPs without per-application
# assignment (Google, GitHub OAuth, etc.). Leave empty where application
# assignment controls access (Authentik, Okta, Keycloak).
OIDC_ALLOWED_DOMAINS=

# NextAuth requires a secret to encrypt session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Dev sign-in: an email and password form on the login page that skips OIDC.
# Type any email and this password to sign in as that email. Honoured only when
# NODE_ENV=development; production builds leave the Credentials provider out.
# Set this (and leave the OIDC_* vars unset) to run locally without an IdP, or
# leave it empty to require OIDC in dev too. Use a long random string.
DEV_AUTH_PASSWORD=
