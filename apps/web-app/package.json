{
  "name": "@scoutui/web-app",
  "version": "0.3.0",
  "description": "The Scout dashboard: design-system adoption across your repos and over time.",
  "homepage": "https://scoutui.dev",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/build-worker.mjs",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:start": "node dist/worker.cjs",
    "start": "next start",
    "lint": "biome lint src tests scripts",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next .turbo",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:rebuild": "node scripts/rebuild.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@base-ui/react": "1.4.1",
    "@floating-ui/react-dom": "^2.1.8",
    "@fontsource/geologica": "5.3.0",
    "@fontsource/monaspace-neon": "5.2.5",
    "@scoutui/palette": "0.1.0",
    "@scoutui/scan-format": "0.1.0",
    "@scoutui/web-shared": "0.1.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.3",
    "lucide-react": "1.16.0",
    "next": "15.5.24",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.21.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "recharts": "3.8.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "ulid": "3.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.12.2",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "jsdom": "25.0.1",
    "shadcn": "4.7.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
